# ---- Site -------------------------------------------------------------------
# "staging" sends X-Robots-Tag noindex and robots disallow; "production" removes both. No staging-only UI exists.
NEXT_PUBLIC_SITE_ENV=staging
NEXT_PUBLIC_SITE_URL=https://ora-world-v2.vercel.app

# ---- Sanity (ORA2_ prefix on purpose) -------------------------------------------
# The build environment also defines NEXT_PUBLIC_SANITY_* for an unrelated site. This site never reads them.
# Leave the project id empty and the whole site renders from the typed seed in src/content/seed.
NEXT_PUBLIC_ORA2_SANITY_PROJECT_ID=
NEXT_PUBLIC_ORA2_SANITY_DATASET=production
NEXT_PUBLIC_ORA2_SANITY_API_VERSION=2025-10-01
# Server-only token with Editor rights: saves leads, runs `pnpm seed`, enables draft mode
ORA2_SANITY_WRITE_TOKEN=
# Secret for the Sanity webhook → POST /api/revalidate
ORA2_SANITY_REVALIDATE_SECRET=

# ---- Maps -------------------------------------------------------------------
# MapLibre GL with OpenFreeMap tiles (no key). Site pin is approximate until the client confirms the parcel.
NEXT_PUBLIC_ORA2_SITE_LAT=18.4542
NEXT_PUBLIC_ORA2_SITE_LNG=-66.3178

# ---- Contact (hidden in the UI until set here or in Sanity) --------------------------
NEXT_PUBLIC_ORA2_PHONE=
NEXT_PUBLIC_ORA2_WHATSAPP=
NEXT_PUBLIC_ORA2_EMAIL=
# Calendly / Cal.com URL for the booking step (request form shown when empty)
NEXT_PUBLIC_ORA2_BOOKING_URL=

# ---- Lead capture / CRM ------------------------------------------------------
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# Cloudflare Turnstile (bypassed when empty)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Confirmation email via Resend (EMAIL_ENABLED=true to send)
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM="ORA World <hello@example.com>"
EMAIL_BCC=
# Optional Upstash Redis for distributed rate limiting (in-memory fallback otherwise)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Analytics (load only after consent, Consent Mode v2) ------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
